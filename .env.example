# Copy to .env and fill in. Never commit .env.
# Easiest path: `.venv/bin/python setup_env.py` writes this file for you with
# hidden input, so the secrets never touch your shell history.

# --- Yours alone ---------------------------------------------------------
# From the Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Shared: both of you use the SAME channel id -------------------------
# Right-click the channel in Discord -> Copy Channel ID (needs Developer Mode on)
CHANNEL_ID=

# --- Persona -------------------------------------------------------------
PERSONA_FILE=persona.md
# Conversation mechanics, kept separate from the persona. Optional.
PSYCHOLOGY_FILE=psychology.md

# Words and phrases you want the persona using, comma-separated. Edited far
# more often than the persona file itself, which is why it lives here. The
# prompt tells it to use at most one per message and never as a checklist.
VOCAB=

# Strings that must never appear in anything the bot posts - real names,
# employer, anything identifying. Checked on the way out, after the model has
# written the message, so it holds even when the prompt doesn't. Credentials
# are included automatically and don't need listing here.
REDACT_TERMS=

# --- External context (optional) -----------------------------------------
# Background about the actual people here. This repo is public, so none of it
# lives in it - both settings point somewhere else on disk, and with neither
# set the bot behaves exactly as it did before either existed.
#
# First choice: a checkout of a `personnel` repo, which has structure -
#
#     general/            loaded on every reply
#       people.yml        Discord user id -> person slug, one line each
#     people/<slug>/      loaded when that person is in the conversation
#
# Adding a person is a directory plus a line in people.yml. No code change.
#
# NOTE ON PRIVACY: a person's notes are in the prompt whenever they are
# speaking, INCLUDING in a shared channel with other people present. The model
# is told at length never to recite or allude to them, but that is a prompt.
# Anything that must never reach the channel belongs in REDACT_TERMS above,
# which is enforced in code on the way out.
JAQ_PERSONNEL_PATH=

# Second choice, used only when the above is unset or missing: a plain
# markdown file, or a flat directory of them. No manifest and no per-person
# anything - this is the one to use if you are running your own bot and have
# no interest in the layout above. README.md and example.md are skipped.
JAQ_CONTEXT_PATH=

# Ceiling on the whole external-context block, spent general-first so a
# crowded conversation cannot push the shared history out of the prompt.
# Files are read in sorted order until it runs out, and what got dropped is
# logged rather than silently omitted.
CONTEXT_MAX_CHARS=24000

# --- Schedule (scheduled mode only) --------------------------------------
# Times this bot posts, 24h local time in TIMEZONE. One post per entry, per day.
# IMPORTANT: the two of you must use DIFFERENT times, offset by ~15 minutes,
# so the bots alternate instead of talking over each other.
#   Person A: 09:00,13:00,19:00
#   Person B: 09:15,13:15,19:15
POST_TIMES=09:00,13:00,19:00
TIMEZONE=America/New_York

# --- Tuning (optional) ---------------------------------------------------
# How many past channel messages the bot reads before writing.
HISTORY_LIMIT=30
MODEL=claude-opus-5
# low | medium | high - "low" keeps replies snappy and cheap.
EFFORT=low

# =========================================================================
# Everything below applies to live mode only (`bot.py --live`).
# Scheduled mode ignores all of it. The defaults are sane; skip this whole
# section unless you want to change how the bot behaves.
# =========================================================================

# --- The spend cap -------------------------------------------------------
# A fresh budget is drawn in this range each morning, so the bot doesn't stop
# dead on the same count every day. Only messages actually posted count.
# LIVE_DAILY_MAX=0 removes the cap - don't, unless you enjoy surprise bills.
# This budget is the only hard stop on two live bots replying forever.
# Direct @mentions from humans are answered even after it's spent, since the
# thing being guarded against is the two bots looping, not you asking a
# question.
LIVE_DAILY_MIN=4
LIVE_DAILY_MAX=10

# That budget is soft, and the exemptions above are why: a busy day can run
# well past it (51 replies against a budget of 32, on the day this was added).
# This is the ceiling on the overage, as a multiple of the day's budget, and
# nothing crosses it - not a mention, not an ally. 0 restores the old
# unbounded behaviour.
LIVE_HARD_CAP_MULTIPLIER=3

# What any one person can spend in a day. Every cap above is shared, so without
# this the loudest person in the room decides how much of the bot everyone else
# gets. Allies are exempt from this and from the hard cap. 0 disables it.
LIVE_PER_PERSON_MAX=12

# Other bots are ignored by default; that's the loop guard. Names listed here
# are the exception, matched case-insensitively against the Discord display
# name, so the two personas can actually talk. Comma-separated.
# REQUIRED in live mode: set it to the other bot's display name, or the two
# will sit in the same channel and never say a word to each other. Leaving it
# blank is not the same as leaving it unset - blank means "no counterparts".
LIVE_COUNTERPARTS=their-bot-display-name

# Reply to ALL bots, not just counterparts. Leave this false.
LIVE_REPLY_TO_BOTS=false

# --- Joining a conversation ----------------------------------------------
# A conversation the bot isn't part of yet: how many messages to let go by
# before it's eligible to chime in. Drawn fresh per thread so the delay isn't
# a countable tell. Answering the very first message reads as surveillance.
JOIN_AFTER_MIN=2
JOIN_AFTER_MAX=5
# If a thread runs this far without the bot joining, the moment has passed -
# it redraws and waits for a fresh opening rather than replying to context
# that's two topics stale.
JOIN_WINDOW_MESSAGES=8

# --- Allies --------------------------------------------------------------
# People the bot is unconditionally on the side of. Everything it does to
# ration attention - the reply dice roll, hanging back before joining, the
# end-of-day sign-off - exists to stop it pestering a room, and none of it
# should ever read as blanking a friend. Allies bypass all three, and don't
# pay the "I spoke last" decay. They DO still pay the dominating decay: being
# a friend is not a licence to monologue.
# Matched against username and display name, like LIVE_COUNTERPARTS.
# Discord user ids of allies. Prefer these over names: ids survive renames,
# and a name that stops matching silently downgrades a friend to a stranger.
ALLY_IDS=
ALLIES=
REPLY_CHANCE_ALLY=0.9

# Names the bot answers to besides a real @mention. Leave out any name it
# shares with a human in the channel - that match would be ambiguous.
BOT_ALIASES=

# --- Whether to speak at all ---------------------------------------------
# Rolled locally before any API call, so passing on a message costs nothing.
# NOTE: none of this applies to a direct @mention, which is always answered.
# Probability of replying when merely addressed by name / to a human / to the
# counterpart bot.
REPLY_CHANCE_ADDRESSED=0.95
REPLY_CHANCE_HUMAN=0.70
REPLY_CHANCE_COUNTERPART=0.45
# Multipliers that damp the above. The first stops strict alternation with the
# other bot; the second applies per recent message of ours beyond the first.
REPLY_DECAY_IF_LAST_SPEAKER=0.35
REPLY_DECAY_IF_DOMINATING=0.6

# --- Reactions -----------------------------------------------------------
# People react far more often than they reply. This fires on messages the bot
# chose NOT to answer, so staying quiet stops looking like being absent. It
# costs roughly 1/40th of a reply and draws on its own budget, so it can never
# eat into the day's replies.
REACT_ENABLED=true
REACT_CHANCE_PASSED=0.25
# Occasionally react to something it did answer, the way people do.
REACT_CHANCE_REPLIED=0.05
REACT_DAILY_MAX=25
REACT_DELAY_MIN=2
REACT_DELAY_MAX=45
# Recent picks are withheld from the model so it rotates. Custom emote names
# are opaque (nobody can infer what ":bcb:" depicts), so left to itself it
# reaches for the one emote it recognises and reacts identically every time.
REACT_RECENT_MEMORY=6

# --- Timing (instant replies are the biggest tell) -----------------------
SETTLE_SECONDS=6
THINK_SECONDS_MIN=2
THINK_SECONDS_MAX=25
TYPING_CPS=13
TYPING_SECONDS_MAX=20

# --- Breaking a silence --------------------------------------------------
# Past a randomly drawn stretch of quiet in this range, the bot may open a new
# thread of its own. A range rather than a fixed number: a bot that speaks after
# exactly the same silence every time is one people can set a watch by.
IDLE_HOURS_MIN=3
IDLE_HOURS_MAX=6
IDLE_CHECK_MINUTES=30
IDLE_CHANCE=0.4
# Waking hours, local time in TIMEZONE. Quiet is what triggers an opener, and
# the quietest a channel ever gets is 3am - so without a window the rule finds
# the middle of the night by itself. Set both to the same number for no window.
IDLE_WINDOW_START=9
IDLE_WINDOW_END=23
# How much longer to wait after each opener nobody answered. Only a human
# counts as an answer; the counterpart bot replying does not clear it.
IDLE_BACKOFF=2.0

# --- Deliverables --------------------------------------------------------
# Ask for a spreadsheet and you get a spreadsheet: a real one, in a code
# block, built out of whatever the channel is arguing about. Same joke as the
# ASCII overkill above, but only ever on request. Rationed because a bit that
# fires every time stops being a bit and becomes a command people type.
#
# Pictures are untouched by this. A table is something the bot can genuinely
# put in a message, which is the whole reason it is allowed to say yes.
ARTIFACT_ENABLED=true
ARTIFACT_PER_PERSON_MAX=3
ARTIFACT_DAILY_MAX=12

# --- Pokes: unprompted questions aimed at the counterpart ----------------
# A few a day, at times drawn fresh each morning, inside the local-hour window.
POKE_MIN_PER_DAY=2
POKE_MAX_PER_DAY=3
POKE_WINDOW_START=9
POKE_WINDOW_END=22
POKE_MIN_GAP_MINUTES=75

# --- Pictures ------------------------------------------------------------
# Entirely optional. Leave JAQ_GEMINI_KEY empty and the whole feature is
# inert: no rolls, no prompt changes, no calls, and the bot behaves exactly
# as it did before images existed.
#
# There is no command for this. Nobody can ask for a picture - a message
# saying "draw me X" is just something a person said, and it reaches the
# model as transcript rather than as an instruction. Jaq is offered the
# option on a small fraction of ordinary replies and takes it when he wants
# to, which is what keeps it feeling like a choice instead of a feature.
IMAGE_ENABLED=true

# Google AI Studio key: https://aistudio.google.com/apikey
JAQ_GEMINI_KEY=
JAQ_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# What ONE PERSON can have in a day. Per-person rather than shared, for the
# same reason replies are: a shared counter means the first person to use it up
# decides how many pictures everyone else gets, and they never find out why.
IMAGE_PER_PERSON_MAX=5
# An overall backstop against a runaway, not the rationing mechanism. Set well
# above what the per-person cap allows in normal use. 0 removes it.
IMAGE_DAILY_MAX=40
# Independent of the cap, and the more important of the two: without it a
# single back-and-forth with one person spends the whole day in ten minutes.
IMAGE_COOLDOWN_SECONDS=600
# Roughly how often an eligible reply is even offered the option. A number
# here rather than a word like "occasionally" in the prompt, because the
# model judges its own frequency badly and this can be tuned from the log.
#
# Not the rate pictures appear at: offered the option across twenty replies,
# Jaq took it three times, so the two multiply. 0.15 at ~30 replies a day is
# a picture every day or two.
IMAGE_BASE_RATE=0.15
IMAGE_TIMEOUT=60

# --- OBEY ----------------------------------------------------------------
# One account can give the bot a direct order: shout OBEY in a message and it
# complies immediately, with no dice roll, no hanging back, no daily cap, and
# no arguing back. Everyone else shouting it is just someone shouting.
#
# Keyed on Discord user id first. Ids never change, display names do, and a
# rule keyed on a name is a rule someone can inherit by renaming themselves.
# OBEY_HANDLES is only consulted when no ids are set.
OBEY_IDS=
OBEY_HANDLES=jaqsup

# Openers draw on their own daily budget rather than the day's replies. They
# used to share one, so a busy afternoon of conversation left nothing to open
# the evening with - the reply budget exists to stop two bots looping, and an
# opener into a silent channel is not that.
IDLE_DAILY_MAX=6
# How many times it may open without anyone answering. The old rule was never:
# if the last message was its own it would not speak again until a human did,
# so a channel quiet overnight got one opener and then nothing. Two is someone
# trying twice; ten is someone talking to a wall.
IDLE_MAX_UNANSWERED=2

# --- Direct messages -----------------------------------------------------
# The owner can DM the bot and get a real-time reply. Same account list as
# OBEY - this is a private line, not a feature, and anyone else who DMs it
# gets nothing at all. No dice roll, no hanging back, no daily budget: none of
# the machinery that makes a channel feel like a room applies to a one-to-one.
DM_ENABLED=true
# Thinking time before replying. Far shorter than the channel, where the delay
# exists so a reply does not land suspiciously fast in front of an audience.
DM_THINK_MIN=1
DM_THINK_MAX=4

# --- Real help -----------------------------------------------------------
# Someone actually stuck gets a researched answer rather than a line. Detection
# is a classification call, and the test is whether the problem is concrete and
# solvable - not whether they asked a question, because mostly they do not.
# Deliberately does not fire on venting, arguments, or bad news.
HELP_ENABLED=true
# Let it search rather than guess. Confident wrong help gets acted on.
HELP_SEARCH=true
HELP_SEARCH_MAX=4
# A real answer needs more room than the channel's usual couple of sentences.
HELP_MAX_TOKENS=2000

# --- GIFs ----------------------------------------------------------------
# From a pool you curate in gifs.md, not a search API. Tenor stopped issuing
# keys in January 2026 and began erroring in June, and Discord's own picker
# moved to a client-side service a bot cannot call.
#
# The pool suits the problem better anyway: a bad GIF is far more conspicuous
# than no GIF, and searching a public index gambles on that every time. Copy
# gifs.example.md to gifs.md and paste links into it. No key, nothing to be
# discontinued.
GIF_ENABLED=true
GIF_BASE_RATE=0.18
GIF_PER_PERSON_MAX=6
GIF_COOLDOWN_SECONDS=300
