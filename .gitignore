# Secrets. .env holds your Discord token and Anthropic key - and so does any
# backup of it, which is the easy one to forget.
.env
.env.*
!.env.example

# Your actual persona. persona.example.md is the shared template.
persona.md
persona.*.md.bak

# The brain. These are notes about real people, derived from a private
# channel - the structure is public, the contents never are.
brain/people/
brain/_index.json

.venv/
__pycache__/
*.log
.bot.pid
.claude/
.bot_state.json
