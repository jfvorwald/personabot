# Secrets. .env holds your Discord token and Anthropic key - and so does any
# backup of it, which is the easy one to forget.
.env
.env.*
!.env.example

# Your actual persona. persona.example.md is the shared template.
persona.md
persona.*.md.bak

# The brain. These are notes about real people, derived from a private
# channel - the structure is public, the contents never are.
brain/people/
brain/_index.json

# Your picture contexts. They describe a specific group's in-jokes, the same
# reason persona.md is not shared. The template and its README are.
contexts/*.md
!contexts/example.md
!contexts/README.md

.venv/
__pycache__/
*.log
.bot.pid
.claude/
.bot_state.json
