# Copy to .env and fill in. Never commit .env.
# Easiest path: `.venv/bin/python setup_env.py` writes this file for you with
# hidden input, so the secrets never touch your shell history.

# --- Yours alone ---------------------------------------------------------
# From the Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Shared: both of you use the SAME channel id -------------------------
# Right-click the channel in Discord -> Copy Channel ID (needs Developer Mode on)
CHANNEL_ID=

# --- Persona -------------------------------------------------------------
PERSONA_FILE=persona.md

# --- Schedule (scheduled mode only) --------------------------------------
# Times this bot posts, 24h local time in TIMEZONE. One post per entry, per day.
# IMPORTANT: the two of you must use DIFFERENT times, offset by ~15 minutes,
# so the bots alternate instead of talking over each other.
#   Person A: 09:00,13:00,19:00
#   Person B: 09:15,13:15,19:15
POST_TIMES=09:00,13:00,19:00
TIMEZONE=America/New_York

# --- Tuning (optional) ---------------------------------------------------
# How many past channel messages the bot reads before writing.
HISTORY_LIMIT=30
MODEL=claude-opus-5
# low | medium | high - "low" keeps replies snappy and cheap.
EFFORT=low

# =========================================================================
# Everything below applies to live mode only (`bot.py --live`).
# Scheduled mode ignores all of it. The defaults are sane; skip this whole
# section unless you want to change how the bot behaves.
# =========================================================================

# --- The spend cap -------------------------------------------------------
# A fresh budget is drawn in this range each morning, so the bot doesn't stop
# dead on the same count every day. Only messages actually posted count.
# LIVE_DAILY_MAX=0 removes the cap - don't, unless you enjoy surprise bills.
# This budget is the only hard stop on two live bots replying forever.
LIVE_DAILY_MIN=4
LIVE_DAILY_MAX=10

# Other bots are ignored by default; that's the loop guard. Names listed here
# are the exception, matched case-insensitively against the Discord display
# name, so the two personas can actually talk. Comma-separated.
# REQUIRED in live mode: set it to the other bot's display name, or the two
# will sit in the same channel and never say a word to each other. Leaving it
# blank is not the same as leaving it unset - blank means "no counterparts".
LIVE_COUNTERPARTS=their-bot-display-name

# Reply to ALL bots, not just counterparts. Leave this false.
LIVE_REPLY_TO_BOTS=false

# --- Whether to speak at all ---------------------------------------------
# Rolled locally before any API call, so passing on a message costs nothing.
# Probability of replying when directly addressed / to a human / to the
# counterpart bot.
REPLY_CHANCE_ADDRESSED=0.95
REPLY_CHANCE_HUMAN=0.70
REPLY_CHANCE_COUNTERPART=0.45
# Multipliers that damp the above. The first stops strict alternation with the
# other bot; the second applies per recent message of ours beyond the first.
REPLY_DECAY_IF_LAST_SPEAKER=0.35
REPLY_DECAY_IF_DOMINATING=0.6

# --- Timing (instant replies are the biggest tell) -----------------------
SETTLE_SECONDS=6
THINK_SECONDS_MIN=2
THINK_SECONDS_MAX=25
TYPING_CPS=13
TYPING_SECONDS_MAX=20

# --- Breaking a silence --------------------------------------------------
# Past IDLE_HOURS of quiet, the bot may open a new thread of its own.
IDLE_HOURS=5
IDLE_CHECK_MINUTES=30
IDLE_CHANCE=0.4

# --- Pokes: unprompted questions aimed at the counterpart ----------------
# A few a day, at times drawn fresh each morning, inside the local-hour window.
POKE_MIN_PER_DAY=2
POKE_MAX_PER_DAY=3
POKE_WINDOW_START=9
POKE_WINDOW_END=22
POKE_MIN_GAP_MINUTES=75
